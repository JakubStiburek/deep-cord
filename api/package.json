{
  "name": "api",
  "version": "0.0.1",
  "description": "",
  "author": "",
  "private": true,
  "license": "UNLICENSED",
  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest ./src",
    "test:watch": "jest --watch ./src",
    "test:cov": "jest --coverage",
    "test:integration": "jest ./test/integration",
    "db:migrate": "chmod +x ./scripts/migrate.sh && ./scripts/migrate.sh up",
    "db:migrate:down": "chmod +x ./scripts/migrate.sh && ./scripts/migrate.sh down",
    "db:migrate:create": "migrate create -ext sql -dir migrations -seq",
    "db:prod:migrate": "chmod +x ./scripts/migrate-prod-db.sh && ./scripts/migrate-prod-db.sh up",
    "db:prod:migrate:down": "chmod +x ./scripts/migrate-prod-db.sh && ./scripts/migrate-prod-db.sh down",
    "db:pgcli": "chmod +x ./scripts/connect-db.sh && ./scripts/connect-db.sh",
    "db:types:generate": "chmod +x ./scripts/generate-types.sh && ./scripts/generate-types.sh"
  },
  "dependencies": {
    "@deepgram/sdk": "3.9.0",
    "@nestjs/common": "10.0.0",
    "@nestjs/config": "3.3.0",
    "@nestjs/core": "10.0.0",
    "@nestjs/platform-express": "10.0.0",
    "@nestjs/swagger": "8.1.0",
    "@nestjs/terminus": "^10.2.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.14.1",
    "luxon": "3.5.0",
    "pg-to-ts": "4.1.1",
    "postgres": "3.4.5",
    "reflect-metadata": "0.1.13",
    "rxjs": "7.8.1",
    "uuid": "11.0.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.2",
    "@types/luxon": "^3.4.2",
    "@types/mock-fs": "^4.13.4",
    "@types/multer": "^1.4.12",
    "@types/node": "^20.3.1",
    "@types/supertest": "^6.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "eslint": "^8.42.0",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-prettier": "^5.0.0",
    "jest": "^29.5.0",
    "mock-fs": "^5.4.1",
    "prettier": "^3.0.0",
    "source-map-support": "^0.5.21",
    "supertest": "^6.3.3",
    "ts-jest": "^29.1.0",
    "ts-loader": "^9.4.3",
    "ts-node": "^10.9.1",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.1.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/jest.setup.ts"
    ]
  },
  "pnpm": {
    "overrides": {
      "express@<4.19.2": ">=4.19.2",
      "webpack@>=5.0.0-alpha.0 <5.94.0": ">=5.94.0",
      "body-parser@<1.20.3": ">=1.20.3",
      "path-to-regexp@>=2.0.0 <3.3.0": ">=3.3.0",
      "path-to-regexp@<0.1.10": ">=0.1.10",
      "cookie@<0.7.0": ">=0.7.0",
      "send@<0.19.0": ">=0.19.0",
      "serve-static@<1.16.0": ">=1.16.0",
      "express@<4.20.0": ">=4.20.0",
      "path-to-regexp@<0.1.12": ">=0.1.12"
    }
  }
}
